# Números que podem falar com a Diza. Só dígitos, com código do país.
USER_PHONE=
ORIGINAL_DIZA_PHONE=

# Nome seu, opcional. Se vazio, ela não inventa um.
USER_NAME=

# Pelo menos uma chave.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Fuso do horário quieto (23:00–08:00).
DIZA_TIMEZONE=Europe/Lisbon

# GET /ping
PING_PORT=3080

# Neon. No Render isto guarda o login do WhatsApp e a memória.
# Usa uma base só da Diza, não a de outro projeto.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/diza?sslmode=require
